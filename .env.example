# Salin file ini menjadi .env, lalu isi nilainya.
# Jangan commit file .env.

# Wajib diisi untuk mengaktifkan login admin.
# Development: minimal 8 karakter.
# Production (NODE_ENV=production): minimal 12 karakter dengan huruf besar,
# huruf kecil, angka, dan simbol. Nilai demo ditolak.
ADMIN_PASSWORD=

# Mode aplikasi: development atau production.
NODE_ENV=development

# Opsional: koneksi MySQL Laragon.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coastalert

# Opsional: chatbot Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
